{
  "data": {
    "dataset": "matlab",
    "path": "../datasets/matlab_amr_dataset.mat",
    "mat_x_key": "X",
    "mat_y_key": "y",
    "mat_snr_key": "snr",
    "mat_channel_key": "channel",
    "mat_split_key": "split",
    "input_length": 512,
    "class_names": [
      "BPSK",
      "QPSK",
      "8PSK",
      "2FSK",
      "4FSK",
      "CPFSK",
      "GFSK",
      "PAM4",
      "QAM16",
      "QAM64",
      "QAM256",
      "AM-DSB",
      "AM-SSB",
      "WBFM",
      "LFM"
    ],
    "channel_names": [
      "AWGN",
      "Rayleigh",
      "Rician",
      "Nakagami",
      "DoublySelective",
      "FrequencySelectiveRayleigh",
      "FrequencySelectiveRician",
      "LognormalShadowing",
      "3GPP_TDL_A",
      "3GPP_TDL_C",
      "3GPP_TDL_E"
    ],
    "train_fraction": 0.6,
    "val_fraction": 0.2,
    "test_fraction": 0.2,
    "batch_size": 512,
    "num_workers": 4,
    "prefetch_factor": 2,
    "persistent_workers": true,
    "hdf5_block_size": 64,
    "normalize": "none",
    "seed": 42
  },
  "model": {
    "name": "vit_splus_1d",
    "num_classes": 15,
    "input_channels": 2,
    "input_length": 512,
    "hidden_channels": 48,
    "dropout": 0,
    "extra": {
      "patch_size": 48,
      "patch_stride": 8,
      "depth": 6,
      "num_heads": 6,
      "ffn_ratio": 6,
      "num_register_tokens": 4,
      "norm_eps": 1e-05,
      "layerscale_init": 1e-05,
      "rope_base": 100,
      "rope_rescale_coords": 2,
      "attention_dropout": 0,
      "drop_path_rate": 0.1,
      "drop_path_schedule": "uniform",
      "ffn_type": "stf_glu",
      "ffn_activation": "silu",
      "embedding_type": "symbol_hierarchical",
      "symbol_length": 8,
      "symbol_channels": 16,
      "embedding_activation": "silu",
      "enable_icsa": true,
      "icsa_hidden_channels": 8,
      "icsa_gate_scale": 0.5,
      "temporal_kernel_sizes": [
        1,
        3,
        5,
        7
      ],
      "frequency_kernel_size": 3,
      "frequency_channels": 8,
      "frequency_window": "hann",
      "frequency_eps": 1e-06
    }
  },
  "train": {
    "epochs": 100,
    "lr": 0.001,
    "min_lr": 1e-05,
    "weight_decay": 0.0001,
    "device": "auto",
    "output_dir": "runs/saftformer_full",
    "early_stop_patience": 15,
    "grad_clip_norm": 5,
    "amp": true,
    "scheduler": "plateau",
    "scheduler_patience": 5,
    "scheduler_factor": 0.5,
    "warmup_epochs": 0,
    "warmup_start_factor": 0.1,
    "log_interval": 100,
    "accumulation_steps": 1,
    "seed": 42,
    "protocol": "standard",
    "stages": {}
  }
}
