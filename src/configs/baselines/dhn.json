{
  "data": {
    "dataset": "matlab",
    "path": "../datasets/matlab_amr_dataset.mat",
    "mat_x_key": "X",
    "mat_y_key": "y",
    "mat_snr_key": "snr",
    "mat_channel_key": "channel",
    "mat_split_key": "split",
    "input_length": 512,
    "class_names": [
      "BPSK",
      "QPSK",
      "8PSK",
      "2FSK",
      "4FSK",
      "CPFSK",
      "GFSK",
      "PAM4",
      "QAM16",
      "QAM64",
      "QAM256",
      "AM-DSB",
      "AM-SSB",
      "WBFM",
      "LFM"
    ],
    "channel_names": [
      "AWGN",
      "Rayleigh",
      "Rician",
      "Nakagami",
      "DoublySelective",
      "FrequencySelectiveRayleigh",
      "FrequencySelectiveRician",
      "LognormalShadowing",
      "3GPP_TDL_A",
      "3GPP_TDL_C",
      "3GPP_TDL_E"
    ],
    "train_fraction": 0.6,
    "val_fraction": 0.2,
    "test_fraction": 0.2,
    "batch_size": 64,
    "num_workers": 4,
    "prefetch_factor": 2,
    "persistent_workers": true,
    "hdf5_block_size": 64,
    "normalize": "none",
    "seed": 42
  },
  "model": {
    "name": "dhn",
    "num_classes": 15,
    "input_channels": 2,
    "input_length": 512,
    "hidden_channels": 64,
    "dropout": 0.0,
    "extra": {
      "attention_reduction": 8
    }
  },
  "train": {
    "epochs": 50,
    "lr": 0.001,
    "min_lr": 1e-05,
    "weight_decay": 0.0,
    "device": "auto",
    "output_dir": "runs/dhn",
    "early_stop_patience": 15,
    "grad_clip_norm": 5.0,
    "amp": true,
    "scheduler": "step",
    "scheduler_patience": 10,
    "scheduler_factor": 0.1,
    "log_interval": 100,
    "accumulation_steps": 1,
    "seed": 42,
    "optimizer": "adam",
    "scheduler_step_size": 10,
    "scheduler_gamma": 0.9,
    "snr_weighting": true,
    "snr_weight_m": 0.3,
    "snr_weight_j": 6.0
  }
}
