# Public repository scope
/*
!/.gitignore
!/README.md
!/LICENSE
!/src/
!/datasets/
!/ref/

# Large datasets are distributed separately.
/datasets/*
!/datasets/README.md

# Keep the bibliography, not local copies of publisher PDFs.
/ref/*
!/ref/README.md

# Experiment and visualization outputs
/src/runs/
/src/dataset_generator_matlab/runs/
/src/result_plotting_matlab/figures/

# Local editor and Python artifacts
/src/.vscode/
**/__pycache__/
*.py[cod]

# MATLAB and operating-system artifacts
*.asv
*.m~
.DS_Store
Thumbs.db
